# ==========================================
# LOVE TALK PODCAST - PRODUCTION ENV CONFIG
# ==========================================

# 1. Environment & Base URL
NODE_ENV=production
NEXTAUTH_URL=https://www.lovetalkpodcast.in
NEXT_PUBLIC_APP_URL=https://www.lovetalkpodcast.in

# 2. MySQL Database Hardening
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lovetalk_prod_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=lovetalkpodcast
DB_CONNECTION_LIMIT=20
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT=60000
DB_SSL=false
ENABLE_AUTO_MIGRATION=false

# 3. Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
INITIAL_SUPER_ADMIN_EMAIL=admin@lovetalkpodcast.in

# 4. Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_live_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Razorpay Subscription Plan IDs
NEXT_PUBLIC_RAZORPAY_PLAN_ID_1=plan_TUDEcZ2uLPWkYl
NEXT_PUBLIC_RAZORPAY_PLAN_ID_2=plan_TUDCZ8dhD0OOmu

# 5. Cloud Object Storage (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=r2
S3_BUCKET_NAME=lovetalk-media-prod
S3_REGION=auto
S3_ACCESS_KEY_ID=your_storage_access_key
S3_SECRET_ACCESS_KEY=your_storage_secret_key
S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
STORAGE_PUBLIC_DOMAIN=https://media.lovetalkpodcast.in
